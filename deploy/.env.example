# Copy to deploy/.env and fill in. Never commit the result.
#
# Generate each secret separately:
#   openssl rand -base64 48

# --- secrets -----------------------------------------------------------------

# Signs session cookies. Rotating it signs everyone out.
BETTER_AUTH_SECRET=

# Shared between the control plane and the relay. The control plane signs a
# short-lived token naming the exact host and port; the relay verifies it.
# If these two do not match, every connection is rejected with 401.
RELAY_SECRET=

POSTGRES_PASSWORD=

# --- public URLs -------------------------------------------------------------
# These are baked into the browser bundle at build time, so changing them
# requires rebuilding the web image, not just restarting it.

# Where users reach the app.
PUBLIC_APP_URL=https://webxterm.example.com

# Where the browser reaches the relay. MUST be wss:// if the app is https:// —
# browsers refuse a plaintext WebSocket from a secure page.
PUBLIC_RELAY_URL=wss://relay.webxterm.example.com/ws

# --- optional ----------------------------------------------------------------

POSTGRES_USER=webxterm
POSTGRES_DB=webxterm
WEB_PORT=3000
RELAY_PORT=8080

# Destination ports the relay may dial. Keep this as small as possible.
RELAY_PORTS=22

RUST_LOG=webxterm_relay=info
