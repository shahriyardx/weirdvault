# Copy to .env beside compose.prod.yaml and fill in. Never commit the result.
#
# Generate each secret separately:
#   openssl rand -base64 48
#
# The web container reads this whole file through `env_file:`, so every name
# here is the name the process actually reads — there is no renaming layer in
# compose to go wrong. The relay is the deliberate exception: it gets an
# explicit list of the nine variables it needs, because handing the
# internet-facing container DATABASE_URL and the Stripe keys to save nine lines
# would undo the reason it has none of them today.
#
# One thing `env_file` cannot do: NEXT_PUBLIC_* is inlined into the browser
# bundle at BUILD time, so compose also passes it as a build arg. Changing it
# needs `docker compose build`, not just a restart.

# --- secrets -----------------------------------------------------------------

# Signs session cookies. Rotating it signs everyone out.
BETTER_AUTH_SECRET=

# Shared between the control plane and the relay. The control plane signs a
# short-lived token naming the exact host and port; the relay verifies it.
# If these two do not match, every connection is rejected with 401.
RELAY_SECRET=

# A second shared secret, and deliberately not the one above. The relay POSTs
# its byte counts to /api/relay/usage with this as a bearer token, so it travels
# on the wire and will end up in a proxy log somewhere; RELAY_SECRET is an HMAC
# signing key that is never transmitted and whose compromise turns the relay
# into an open proxy. Two purposes, two blast radii.
#
# Leaving this blank is a supported choice: the relay logs at startup that it is
# counting nothing, no usage is ever recorded, and the monthly transfer
# allowance is never enforced. That is the right default for a relay you host
# yourself — the cap exists because relay bandwidth costs the hosted deployment
# money, and bandwidth you already pay for is not ours to ration. The transfer
# meter in Settings says so on screen rather than showing a reassuring zero.
RELAY_USAGE_SECRET=

# A third shared secret, for agents — machines with no public address that dial
# the relay instead of being dialled. The relay cannot check an agent's signature
# itself (it holds no keys and no database, on purpose), so it asks
# /api/agents/verify with this as a bearer token.
#
# Separate from RELAY_USAGE_SECRET so that agents and usage reporting can be
# turned on independently. Setting one must not silently enable the other.
#
# Blank is supported and means agents are off: the relay says so at startup,
# /agent/control refuses connections, and the "Add a machine" flow refuses to
# mint an enrollment token rather than producing an agent that can never connect.
RELAY_AGENT_SECRET=

POSTGRES_PASSWORD=

# Where the app finds Postgres. Written out rather than assembled from the
# POSTGRES_* values below, because env_file does no interpolation — keep the
# password here in step with the one above.
DATABASE_URL=postgres://webxterm:CHANGEME@postgres:5432/webxterm

# --- billing (optional; leaving all three blank is a supported deployment) ----
#
# Stripe sells the Pro tier: one subscription per account, one price, no seats.
# All three are read at request time rather than at build time, so adding them
# needs a restart and not a rebuild.
#
# Leave them blank and the app says so on screen instead of pretending. The plan
# card in Settings reports that no billing is configured on this deployment and
# offers no button; nothing 500s, nothing is silently granted, and nothing is
# silently denied. Every account is then whatever the subscription table says,
# which on an install that has never taken a payment is Free.

# Server-side Stripe API key. Never sent to a browser, never logged.
STRIPE_SECRET_KEY=

# The Price object Pro is charged against. There is deliberately no fallback in
# the code: with this unset, checkout refuses and names this variable rather
# than charging against a price id compiled into the image. It must be a
# recurring price — Checkout is created in subscription mode.
#
# The amount lives in Stripe, and PRO_PRICE_USD in
# apps/web/src/lib/billing/tiers.ts is what /pricing prints. Nothing checks the
# two agree; change them together.
STRIPE_PRICE_PRO=

# Signs webhook deliveries, and is the only thing standing between a stranger
# and granting themselves a subscription — /api/billing/webhook has no session,
# no cookie and no bearer token by design, because Stripe's servers have none.
# Get it from the endpoint's own page in the Stripe dashboard; each endpoint has
# its own secret, and the CLI's `stripe listen` prints a different one again.
#
# With this unset the webhook answers 503 so Stripe retries rather than
# believing the delivery landed. Checkout would still work and no subscription
# would ever be recorded, which is the one genuinely broken half-configuration
# here — set all three or none.
STRIPE_WEBHOOK_SECRET=

# --- GitHub sign-in (optional; leaving both blank is a supported deployment) --
#
# Adds "Continue with GitHub" to the sign-in and sign-up pages. Register an
# OAuth app at https://github.com/settings/developers with the callback URL
#
#   <BETTER_AUTH_URL>/api/auth/callback/github
#
# Both are read once, when the server starts, because the provider list is built
# then. Adding them needs a restart; it does not need a rebuild.
#
# Leave them blank and there is simply no button. The provider is not
# registered, the sign-in page renders nothing about GitHub, and no request can
# reach a half-configured OAuth flow — a capability that is absent is absent,
# rather than a control that fails when pressed. There is deliberately no
# fallback client id: one compiled into the image would be somebody's real
# GitHub app.
#
# What GitHub does NOT do here, because it cannot: open the vault. Signing in
# with it types no password, so no key is derived, and a new account is sent to
# /set-vault-password to choose one before it can store anything. That password
# is the vault key's only source, permanently and by design — the OAuth session
# proves who somebody is and never what they can decrypt.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- public URLs -------------------------------------------------------------

# Where users reach the app. Read at runtime; a restart is enough.
BETTER_AUTH_URL=https://webxterm.example.com

# Where the browser reaches the relay. MUST be wss:// if the app is https:// —
# browsers refuse a plaintext WebSocket from a secure page.
#
# Baked into the browser bundle at BUILD time as well as read at runtime, so
# changing it needs `docker compose build web`. Serving it on the same origin as
# the app (wss://your-app/ws) means one certificate, one domain, and a relay
# container with no published port; see the reverse proxy notes in
# compose.prod.yaml.
NEXT_PUBLIC_RELAY_URL=wss://webxterm.example.com/ws

# --- recording storage (optional; all four blank is a supported deployment) ---
#
# Where session recordings are kept. Blank means the encrypted blob goes in a
# `bytea` column in Postgres, which is what this app did before object storage
# existed and is still the right answer for a self-hosted install: the
# recordings are in the backup you already take, deletion is a foreign key
# rather than a reconciliation job, and there are no orphaned objects to sweep.
#
# Set all four and new recordings go to the bucket instead, with only the
# metadata and the object key left in the row. That matters at scale rather than
# at home: a gigabyte per account times N accounts is in every `pg_dump`, so
# backup size and restore time start tracking recording volume rather than data
# volume.
#
# Setting some but not all is a typo and is treated as one. The app says which
# variable is missing at startup and keeps writing to Postgres, rather than
# silently doing that on a deployment whose operator believes otherwise.
#
# Rows written before and after the switch are both readable, in both
# directions, so turning this on or off is not a migration and does not strand
# anything already saved.
#
# What the bucket must NOT have: a public URL. Neither the r2.dev development
# subdomain nor a custom domain. Objects are fetched by this server with these
# credentials and proxied to the browser through a route that has already
# checked who is asking; there is deliberately no presigned-URL path, because a
# signed URL is a second thing that grants access — and, for share links, one
# that has never heard of `revoked_at`. See docs/TODO.md.
#
# The blob is AES-GCM ciphertext whose key is derived in the browser and never
# sent, so a leaked bucket is an envelope and nothing else. That is what makes
# this a plumbing decision rather than a security one — not a reason to skip the
# private bucket.

# The S3 API endpoint. For R2 this is https://<account-id>.r2.cloudflarestorage.com,
# shown on the bucket's settings page. Any S3-compatible endpoint works.
R2_ENDPOINT=

R2_BUCKET=

# An R2 API token scoped to Object Read & Write on this bucket alone. It does
# not need bucket creation, listing other buckets, or anything at the account
# level.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# R2 has one region and calls it `auto`, which is the default here. Set it only
# if you are pointing at something else — MinIO, Ceph, S3 itself — where the
# region is part of the signature and getting it wrong is a 403.
R2_REGION=

# --- optional ----------------------------------------------------------------

# Where agents download newer builds of themselves, and where /install.sh sends
# people. Defaults to <your origin>/agent-bin, which is what `bun run agent`
# publishes. Agents refuse to self-update over plaintext http from anywhere but
# loopback, so a deployment served over http:// simply never self-updates.
AGENT_RELEASE_BASE_URL=

# --- who the caller is ---------------------------------------------------------
#
# Two variables for one fact, and they are not interchangeable. Both answer
# "which X-Forwarded-For entry did my own proxy write", because everything to
# the left of it is a value the client chose. They differ because the two pieces
# of code that need the answer want it in different shapes and neither can be
# derived from the other: our own routes count hops from the right, Better Auth
# matches proxy addresses. Set them together or set neither.
#
# What depends on getting this right:
#
#   The audit log, which records a network prefix per event. `recovery.redeemed`
#   is the worst case — the one row that says somebody got in without the
#   password. A fabricated address is worse than a missing one.
#
#   Every rate limit. Unauthenticated limits key on the client address, so an
#   address the caller chooses is a fresh budget on every request and the limit
#   stops existing. Unset is safe rather than broken: the address is treated as
#   unknown and everybody shares one bucket per endpoint, which a stranger can
#   trip for everyone. That is a nuisance; a limiter that stops nobody is worse.

# How many proxies sit in front of the app. 1 behind a single reverse proxy,
# 2 behind a CDN in front of that. Guessing high is worse than leaving it unset,
# because it reads an entry the client still controls. Read by the audit log and
# by the app's own rate limits.
TRUSTED_PROXY_HOPS=

# The addresses those proxies connect from, comma-separated, as IPs or CIDR
# ranges. Read by Better Auth for the limits on /api/auth/*. Behind a reverse
# proxy on the same host this is usually the Docker bridge — 172.16.0.0/12 — or
# 127.0.0.1 when the proxy is not containerised. Left blank, Better Auth trusts
# only a single-valued header and otherwise falls back to one shared bucket.
TRUSTED_PROXY_IPS=

POSTGRES_USER=webxterm
POSTGRES_DB=webxterm
WEB_PORT=3000
RELAY_PORT=8080

# Destination ports the relay may dial. Keep this as small as possible.
RELAY_PORTS=22

# How often the relay flushes its byte counts to the control plane, in seconds.
# Only read when RELAY_USAGE_SECRET is set. Longer means an account can move
# more before the allowance notices; shorter means more requests for no other
# gain. A batch that cannot be delivered is dropped rather than retried, so this
# is also the most that one failed flush can lose.
RELAY_USAGE_INTERVAL_SECS=60

RUST_LOG=webxterm_relay=info
