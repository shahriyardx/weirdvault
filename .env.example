# Copy to .env beside compose.prod.yaml and fill in. Never commit the result.
# What every variable does: docs/DEPLOY.md § Configuration.
#
#   openssl rand -base64 48     # for each secret below

# --- required ---------------------------------------------------------------

BETTER_AUTH_SECRET=
RELAY_SECRET=
POSTGRES_PASSWORD=

# Keep the password here in step with POSTGRES_PASSWORD above; env_file does no
# interpolation.
DATABASE_URL=postgres://weirdvault:CHANGEME@postgres:5432/weirdvault

BETTER_AUTH_URL=https://weirdvault.example.com

# Must be wss:// if the app is https://. Baked into the browser bundle at build
# time, so changing it needs `docker compose build web`.
NEXT_PUBLIC_RELAY_URL=wss://weirdvault.example.com/ws

# Scheduled cleanup. Blank means it never runs.
CRON_SECRET=

# --- optional: leave blank to switch the feature off ------------------------

# Transfer metering and the monthly allowance.
RELAY_USAGE_SECRET=

# Machines with no public address.
RELAY_AGENT_SECRET=

# Signs the instructions the dashboard sends to a machine — restart, update,
# stop, and the stop that follows a revoke. 32 bytes:
#
#   openssl rand -base64 32
#
# Its public half is written into each agent's identity file at enrolment, so an
# agent can tell an instruction you authorised from one the relay invented. Blank
# means no machine can be controlled from the dashboard, which is a supported
# configuration — everything else works, and the controls are simply absent.
#
# Machines enrolled before it was set do not have the key and refuse commands
# until they are enrolled again.
AGENT_COMMAND_SECRET=

# Only while rotating that key. Set this to the *old* seed and AGENT_COMMAND_SECRET
# to the new one: scheduled maintenance hands the new public half to each machine
# as it is seen online, signed by the old key — the only one those machines trust
# until it lands. A machine that is asleep gets it on a later run. Unset it once
# every machine reports the new key; leaving it set keeps a retired key able to
# command the fleet.
AGENT_COMMAND_SECRET_PREVIOUS=

# Where the app reaches the relay, server to server, to ask which machines are
# connected right now. Not the public address: this hop stays on the private
# network, so a proxy having a bad day cannot make the dashboard unable to say
# whether a machine is online. Unset, it is derived from NEXT_PUBLIC_RELAY_URL
# — which works, and goes out through your proxy and back.
RELAY_INTERNAL_URL=http://relay:8080

# Billing. All three, or none.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_WEBHOOK_SECRET=

# "Continue with GitHub" on the sign-in page.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session recordings in a bucket instead of Postgres. All four, or none.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=

# Set both once a reverse proxy is in front, or no client address is recorded
# and every unauthenticated rate limit shares one bucket.
TRUSTED_PROXY_HOPS=
TRUSTED_PROXY_IPS=

# Where agent binaries are published. Defaults to <your origin>/agent-bin.
AGENT_RELEASE_BASE_URL=

# What the agent binaries and their manifest are stamped with. An agent updates
# itself when the manifest's value differs from its own, so bump this when you
# ship a new agent and not otherwise. Left at "dev" it never differs, and no
# machine in the field ever picks up a fix.
AGENT_VERSION=v1.0.0

# --- defaults: change only if you need to -----------------------------------

POSTGRES_USER=weirdvault
POSTGRES_DB=weirdvault
WEB_PORT=3000
RELAY_PORT=8080

# Destination port allowlist. Keep this as small as you can.
RELAY_PORTS=22

CRON_SCHEDULE=15 4 * * *
RELAY_USAGE_INTERVAL_SECS=60
RUST_LOG=weirdvault_relay=info
