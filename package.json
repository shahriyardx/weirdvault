{
  "name": "webxterm",
  "private": true,
  "type": "module",
  "description": "Zero-install web SSH client: browser, key, connect. Nothing to install on either end.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "db:up": "docker compose -f deploy/compose.yaml up -d postgres",
    "db:down": "docker compose -f deploy/compose.yaml down",
    "db:push": "bun run --cwd apps/web db:push",
    "db:studio": "bun run --cwd apps/web db:studio",
    "size": "bun scripts/size.mjs apps/web/public/ssh.wasm",
    "verify:signedout": "bun scripts/signedout-verify.mjs",
    "verify:app": "bun scripts/phase2-verify.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
