# env
.env*.local

# A copy of .env taken before editing it, which is the first thing anybody does
# on a server before changing a secret. Ignored so that having one does not stop
# scripts/deploy.sh, whose refusal to pull over a dirty tree would otherwise fire
# on the most careful thing an operator can do.
.env.bak*
.env.*.bak

# bun
.bun/

# rust
target/

# the phase 0 harness, removed — kept out of the tree if it reappears locally
spike/

# Built on demand by scripts/build-agent.mjs, like ssh.wasm. Not committed:
# ~8 MB per target, and one command rebuilds them.
apps/web/public/agent-bin/

# Built agent binaries. `bun run agent` writes the release set to
# apps/web/public/agent-bin; `go build` in apps/agent leaves one behind here.
apps/agent/agent
apps/web/public/agent-bin/
